# Copiar a .env y completar los valores
#   cp .env.example .env

# --- BD (también usa docker-compose para el servicio db) ---
DB_USER=postgres
DB_PASSWORD=cambieme-en-produccion
DB_NAME=scrapper
DB_SSLMODE=disable

# Puerto publicado SOLO en 127.0.0.1 para conectar herramientas locales
DB_PUBLISHED_PORT=5432

# --- Seguridad ---
# Obligatorio: la app no arranca en producción sin él
JWT_SECRET=

# production | development
ENVIROMENT=production

# --- App ---
APP_PORT=3000
CORS_ORIGINS=http://localhost:34115,http://localhost:5173
